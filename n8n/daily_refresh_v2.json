                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "function parseSummary(input) {\n  if (input \u0026\u0026 typeof input === \u0027object\u0027 \u0026\u0026 input.target_day \u0026\u0026 Array.isArray(input.sheet_rows)) {\n    return input;\n  }\n\n  const candidates = [input?.content, input?.data, input?.fileContent, input?.jsonContent];\n  for (const candidate of candidates) {\n    if (typeof candidate === \u0027string\u0027 \u0026\u0026 candidate.trim()) {\n      try {\n        const parsed = JSON.parse(candidate);\n        if (parsed \u0026\u0026 parsed.target_day \u0026\u0026 Array.isArray(parsed.sheet_rows)) {\n          return parsed;\n        }\n      } catch (error) {\n        // Try the next candidate.\n      }\n    }\n  }\n\n  return input ?? {};\n}\n\nfunction formatDate(isoDate) {\n  if (!isoDate) return \u0027\u0027;\n  const date = new Date(`${isoDate}T00:00:00`);\n  if (Number.isNaN(date.getTime())) return String(isoDate);\n  return `${date.getDate()}.${date.getMonth() + 1}.${date.getFullYear()}`;\n}\n\nfunction formatRatio(ratio) {\n  if (ratio === null || ratio === undefined || ratio === \u0027\u0027) {\n    return \u0027bez dat\u0027;\n  }\n\n  const value = Number(ratio);\n  if (Number.isNaN(value)) {\n    return \u0027bez dat\u0027;\n  }\n\n  return `${(value * 100).toFixed(1).replace(\u0027.\u0027, \u0027,\u0027)} %`;\n}\n\nfunction stripLeadingEquals(value) {\n  return String(value ?? \u0027\u0027).replace(/^\\s*=+\\s*/, \u0027\u0027).trim();\n}\n\nconst summary = parseSummary($json);\nconst targetDayText = formatDate(summary.target_day);\nconst rows = Array.isArray(summary.sheet_rows) ? summary.sheet_rows : [];\nconst mailLines = Array.isArray(summary.mail_lines) \u0026\u0026 summary.mail_lines.length\n  ? summary.mail_lines\n  : rows.map((row) =\u003e `${row.sheet}: ${formatRatio(row.ratio)} eliminace z geosize = SPO, doprava = alzabox`);\nconst safeMailLines = mailLines.map(stripLeadingEquals);\nconst bodyContent = safeMailLines.map((line) =\u003e `\u003cp style=\"margin: 0 0 6px;\"\u003e${line}\u003c/p\u003e`).join(\u0027\u0027);\n\nreturn [\n  {\n    json: {\n      subject: stripLeadingEquals(`Eliminace v posledný deň - ${targetDayText}`),\n      toRecipients: [\n        {\n          emailAddress: {\n            address: \u0027peter.kadlec@alza.sk\u0027\n          }\n        }\n      ],\n      bodyContent,\n      bodyContentType: \u0027html\u0027,\n      targetDay: summary.target_day ?? \u0027\u0027,\n      generatedAt: summary.generated_at ?? \u0027\u0027\n    }\n  }\n];"
                                     },
